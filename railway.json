{
  "$schema": "https://railway.app/railway.schema.json",
  "deploy": {
    "startCommand": "node --experimental-sqlite server/index.js",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "setup": {
          "nixPkgs": ["libsqlite3"]
        }
      }
    }
  }
}
